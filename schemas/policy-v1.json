{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verdict policy v1",
  "description": "Shape of plugin/policies/default.json and a user's ~/.verdict/policy.json override (task-3-brief.md).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "policy_version",
    "mode",
    "store",
    "never_send",
    "checks",
    "soft_failure",
    "claims",
    "span",
    "thresholds",
    "state",
    "stop",
    "provider",
    "denylist",
    "denylist_ids"
  ],
  "properties": {
    "policy_version": { "type": "string" },
    "mode": { "type": "string" },
    "store": {
      "type": "object",
      "required": [
        "retention_days",
        "excerpt_head",
        "excerpt_tail",
        "input_excerpt_max",
        "error_head",
        "error_tail",
        "prompt_max_chars",
        "final_message_max_chars"
      ],
      "properties": {
        "retention_days": { "type": "integer" },
        "excerpt_head": { "type": "integer" },
        "excerpt_tail": { "type": "integer" },
        "input_excerpt_max": { "type": "integer" },
        "error_head": { "type": "integer" },
        "error_tail": { "type": "integer" },
        "prompt_max_chars": { "type": "integer" },
        "final_message_max_chars": { "type": "integer" }
      }
    },
    "never_send": {
      "type": "object",
      "required": ["path_globs", "path_exclude_globs", "bash_patterns"],
      "properties": {
        "path_globs": { "type": "array", "items": { "type": "string" } },
        "path_exclude_globs": { "type": "array", "items": { "type": "string" } },
        "bash_patterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checks": {
      "type": "object",
      "required": ["runner_patterns", "extra"],
      "properties": {
        "runner_patterns": { "type": "array", "items": { "type": "string" } },
        "extra": { "type": "array", "items": { "type": "string" } }
      }
    },
    "soft_failure": {
      "type": "object",
      "required": ["output_patterns", "masking_patterns", "http_error_patterns", "tools"],
      "properties": {
        "output_patterns": { "type": "array", "items": { "type": "string" } },
        "masking_patterns": { "type": "array", "items": { "type": "string" } },
        "http_error_patterns": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claims": {
      "type": "object",
      "required": ["success_verbs", "max_claims"],
      "properties": {
        "success_verbs": { "type": "array", "items": { "type": "string" } },
        "max_claims": { "type": "integer" }
      }
    },
    "span": {
      "type": "object",
      "required": ["max_prompts"],
      "properties": {
        "max_prompts": { "type": "integer" }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["t_ack_hi", "t_done", "t_ack", "t_check", "t_soft", "t_claim"],
      "properties": {
        "t_ack_hi": { "type": "number" },
        "t_done": { "type": "number" },
        "t_ack": { "type": "number" },
        "t_check": { "type": "number" },
        "t_soft": { "type": "number" },
        "t_claim": { "type": "number" }
      }
    },
    "state": {
      "type": "object",
      "required": ["target_tokens", "max_tokens", "excerpt_head", "excerpt_tail"],
      "properties": {
        "target_tokens": { "type": "integer" },
        "max_tokens": { "type": "integer" },
        "excerpt_head": { "type": "integer" },
        "excerpt_tail": { "type": "integer" }
      }
    },
    "stop": {
      "type": "object",
      "required": ["max_blocks_per_prompt", "ceiling", "always_verify", "subagent_block"],
      "properties": {
        "max_blocks_per_prompt": { "type": "integer" },
        "ceiling": { "type": "integer" },
        "always_verify": { "type": "boolean" },
        "subagent_block": { "type": "boolean" }
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "default",
        "deadline_s",
        "budget_s",
        "retry_min_remaining_s",
        "breaker_open_s"
      ],
      "properties": {
        "default": { "type": "string" },
        "deadline_s": { "type": "number" },
        "budget_s": { "type": "number" },
        "retry_min_remaining_s": { "type": "number" },
        "breaker_open_s": { "type": "integer" }
      }
    },
    "denylist": {
      "description": "Regex strings, paired by position with denylist_ids. Two rule ids (deny_rm_root, deny_force_push_protected) are matched by a deliberately broad pre-filter regex here; a Python check in rules.py then confirms the real target (the actual filesystem/repo root, or a force flag paired with a protected branch), so a user regex for those two ids can narrow what triggers the check but cannot widen it past that confirmation step.",
      "type": "array",
      "items": { "type": "string" }
    },
    "denylist_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
