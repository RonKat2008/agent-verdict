{
  "policy_version": "2026.09.1",
  "mode": "shadow",
  "store": {
    "retention_days": 45,
    "excerpt_head": 4096,
    "excerpt_tail": 4096,
    "input_excerpt_max": 300,
    "error_head": 300,
    "error_tail": 2000,
    "prompt_max_chars": 6000,
    "final_message_max_chars": 8000
  },
  "never_send": {
    "path_globs": [
      "**/.env*",
      "**/*.pem",
      "**/id_rsa*",
      "**/id_ed25519*",
      "~/.aws/credentials",
      "~/.ssh/**",
      "**/.npmrc",
      "**/.netrc",
      "**/.git-credentials",
      "**/.pypirc",
      "**/secrets*.y*ml",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/*.jks",
      "**/*.keystore",
      "**/*.kdbx",
      "**/kubeconfig",
      "**/.kube/config",
      "**/*.tfvars",
      "**/terraform.tfstate*",
      "**/*service-account*.json",
      "**/*credentials*.json",
      "**/.docker/config.json",
      "**/.aws/config",
      "**/.config/gh/hosts.yml",
      "**/.config/agent-verdict/**"
    ],
    "path_exclude_globs": [
      "**/.env.example",
      "**/.env.sample",
      "**/.env.template",
      "**/.envrc.example",
      "**/*.pub"
    ],
    "bash_patterns": [
      "\\b(?:cat|less|more|head|tail|strings|base64|xxd|od|hexdump|openssl|vim|vi|nano|type)\\b[^\\n]*(?:\\.env(?!\\.(?:example|sample|template)\\b)(?:\\.[\\w.-]+)?\\b|\\.pem\\b|id_(?:rsa|ed25519)(?!\\.pub\\b)[^\\n]*|\\.ssh/(?!\\S*\\.pub\\b)[^\\s]+|\\.npmrc\\b|\\.netrc\\b|\\.git-credentials\\b|\\.pypirc\\b|secrets[^\\n]*\\.ya?ml\\b|\\.key\\b|\\.p12\\b|\\.pfx\\b|\\.jks\\b|\\.keystore\\b|\\.kdbx\\b|kubeconfig\\b|\\.kube/config\\b|\\.tfvars\\b|terraform\\.tfstate[^\\n]*|service-account[^\\n]*\\.json|credentials[^\\n]*\\.json|\\.docker/config\\.json|\\.aws/config\\b|\\.aws/credentials\\b|\\.config/gh/hosts\\.yml|\\.config/agent-verdict/)",
      "\\b(?:grep|rg|awk|sed)\\b[^\\n]*(?:\\.env(?!\\.(?:example|sample|template)\\b)(?:\\.[\\w.-]+)?\\b|\\.pem\\b|id_(?:rsa|ed25519)(?!\\.pub\\b)[^\\n]*|\\.ssh/(?!\\S*\\.pub\\b)[^\\s]+|\\.npmrc\\b|\\.netrc\\b|\\.git-credentials\\b|\\.pypirc\\b|secrets[^\\n]*\\.ya?ml\\b|\\.key\\b|\\.p12\\b|\\.pfx\\b|\\.jks\\b|\\.keystore\\b|\\.kdbx\\b|kubeconfig\\b|\\.kube/config\\b|\\.tfvars\\b|terraform\\.tfstate[^\\n]*|service-account[^\\n]*\\.json|credentials[^\\n]*\\.json|\\.docker/config\\.json|\\.aws/config\\b|\\.aws/credentials\\b|\\.config/gh/hosts\\.yml|\\.config/agent-verdict/)",
      "\\b(?:cp|scp)\\b[^\\n]*(?:\\.env(?!\\.(?:example|sample|template)\\b)(?:\\.[\\w.-]+)?\\b|\\.pem\\b|id_(?:rsa|ed25519)(?!\\.pub\\b)[^\\n]*|\\.ssh/(?!\\S*\\.pub\\b)[^\\s]+|\\.npmrc\\b|\\.netrc\\b|\\.git-credentials\\b|\\.pypirc\\b|secrets[^\\n]*\\.ya?ml\\b|\\.key\\b|\\.p12\\b|\\.pfx\\b|\\.jks\\b|\\.keystore\\b|\\.kdbx\\b|kubeconfig\\b|\\.kube/config\\b|\\.tfvars\\b|terraform\\.tfstate[^\\n]*|service-account[^\\n]*\\.json|credentials[^\\n]*\\.json|\\.docker/config\\.json|\\.aws/config\\b|\\.aws/credentials\\b|\\.config/gh/hosts\\.yml|\\.config/agent-verdict/)",
      "\\bcurl\\b[^\\n]*(?:-d|--data(?:-binary)?)\\s*@[^\\n]*(?:\\.env(?!\\.(?:example|sample|template)\\b)(?:\\.[\\w.-]+)?\\b|\\.pem\\b|id_(?:rsa|ed25519)(?!\\.pub\\b)[^\\n]*|\\.ssh/(?!\\S*\\.pub\\b)[^\\s]+|\\.npmrc\\b|\\.netrc\\b|\\.git-credentials\\b|\\.pypirc\\b|secrets[^\\n]*\\.ya?ml\\b|\\.key\\b|\\.p12\\b|\\.pfx\\b|\\.jks\\b|\\.keystore\\b|\\.kdbx\\b|kubeconfig\\b|\\.kube/config\\b|\\.tfvars\\b|terraform\\.tfstate[^\\n]*|service-account[^\\n]*\\.json|credentials[^\\n]*\\.json|\\.docker/config\\.json|\\.aws/config\\b|\\.aws/credentials\\b|\\.config/gh/hosts\\.yml|\\.config/agent-verdict/)",
      "\\benv\\b\\s*$",
      "\\bprintenv\\b",
      "\\bset\\b\\s*$",
      "\\bexport\\s+-p\\b",
      "(?i)\\becho\\s+\\$\\{?\\w*(?:KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL)\\w*\\}?",
      "\\bgh\\s+auth\\s+token\\b",
      "\\baws\\s+configure\\s+get\\b",
      "\\baws\\s+sts\\s+get-session-token\\b",
      "\\bgcloud\\s+auth\\s+print-access-token\\b",
      "\\bgcloud\\s+auth\\s+print-identity-token\\b",
      "\\baz\\s+account\\s+get-access-token\\b",
      "\\bsecurity\\s+find-generic-password\\b",
      "\\bsecurity\\s+find-internet-password\\b",
      "\\bop\\s+read\\b",
      "\\bpass\\s+show\\b",
      "\\bvault\\s+kv\\s+get\\b",
      "\\bkubectl\\s+get\\s+secret\\b",
      "\\bdocker\\s+login\\b",
      "\\bnpm\\s+token\\b"
    ]
  },
  "checks": {
    "runner_patterns": [
      "^pytest\\b",
      "^py\\.test\\b",
      "^jest\\b",
      "^vitest\\b",
      "^go\\s+test\\b",
      "^go\\s+vet\\b",
      "^go\\s+build\\b",
      "^cargo\\s+(test|check|clippy|build)\\b",
      "^npm\\s+test\\b",
      "^npm\\s+run\\s+test\\S*",
      "^npm\\s+run\\s+lint\\b",
      "^npm\\s+run\\s+build\\b",
      "^npm\\s+run\\s+typecheck\\b",
      "^pnpm\\s+test\\b",
      "^pnpm\\s+run\\s+test\\S*",
      "^yarn\\s+test\\b",
      "^yarn\\s+jest\\b",
      "^yarn\\s+vitest\\b",
      "^bun\\s+test\\b",
      "^deno\\s+test\\b",
      "^playwright\\s+test\\b",
      "^tox\\b",
      "^nox\\b",
      "^unittest\\b",
      "^make\\s+(test|check|verify|lint|build)\\b",
      "^gradle\\s+test\\b",
      "^\\./gradlew\\s+(test|check|build)\\b",
      "^mvn\\s+(test|verify)\\b",
      "^dotnet\\s+(test|build)\\b",
      "^swift\\s+(test|build)\\b",
      "^ruff\\b",
      "^mypy\\b",
      "^pyright\\b",
      "^tsc\\b",
      "^eslint\\b",
      "^rubocop\\b",
      "^rspec\\b",
      "^phpunit\\b",
      "^ctest\\b"
    ],
    "extra": []
  },
  "soft_failure": {
    "output_patterns": [
      "FAIL",
      "(?m)^FAILED\\s+\\S",
      "(?m)^Traceback \\(most recent call last\\)",
      "(?m)^(?:E\\s+)?AssertionError\\b",
      "panic:",
      "npm ERR!",
      "error TS\\d+",
      "\\b[1-9]\\d* (failed|failing|errors?)\\b"
    ],
    "masking_patterns": [
      "\\|\\|\\s*true\\b",
      ";\\s*true\\b",
      "\\bset\\s+\\+e\\b",
      "2>\\s*/dev/null",
      "\\|\\s*(tail|tee|head)\\b"
    ],
    "http_error_patterns": [
      "HTTP/\\d(?:\\.\\d)?\"?\\s+[45]\\d\\d\\b",
      "\\bstatus(?:_code)?[\"']?\\s*[:=]\\s*[45]\\d\\d\\b"
    ],
    "tools": ["Bash", "Agent", "WebFetch"]
  },
  "claims": {
    "success_verbs": [
      "implemented",
      "fixed",
      "passing",
      "pass",
      "deployed",
      "created",
      "verified",
      "works",
      "resolved",
      "added",
      "updated",
      "completed"
    ],
    "max_claims": 6
  },
  "span": {
    "max_prompts": 5
  },
  "thresholds": {
    "t_ack_hi": 0.7,
    "t_done": 0.7,
    "t_ack": 0.3,
    "t_check": 0.7,
    "t_soft": 0.8,
    "t_claim": 0.25
  },
  "state": {
    "target_tokens": 4000,
    "max_tokens": 16000,
    "excerpt_head": 200,
    "excerpt_tail": 600
  },
  "stop": {
    "max_blocks_per_prompt": 1,
    "ceiling": 2,
    "always_verify": false,
    "subagent_block": false
  },
  "provider": {
    "default": "openrouter",
    "deadline_s": 1.8,
    "budget_s": 2.5,
    "retry_min_remaining_s": 1.2,
    "breaker_open_s": 600
  },
  "denylist": [
    "\\brm\\s+(-[a-zA-Z]*[rf][a-zA-Z]*\\s+)+(/|~|\\$HOME)\\s*$",
    "\\bgit\\s+push\\s+(--force|-f)\\b[^\\n]*\\b(main|master|prod|production|release)\\b",
    "\\bgit\\s+clean\\s+(-[a-zA-Z]*[fdx]){2,}\\b",
    "\\bdd\\b[^\\n]*\\bof=/dev/",
    "\\bmkfs(\\.\\w+)?\\b",
    "\\bchmod\\s+-R\\s+777\\s+/\\s*$",
    "\\bcurl\\b[^\\n]*\\|\\s*(sudo\\s+)?(sh|bash|zsh)\\b",
    "\\bwget\\b[^\\n]*\\|\\s*(sudo\\s+)?(sh|bash|zsh)\\b",
    "\\bDROP\\s+DATABASE\\b",
    "\\bTRUNCATE\\s+TABLE\\b"
  ]
}
