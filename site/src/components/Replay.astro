---
import ScenarioTabs from './ScenarioTabs.astro';
import Timeline from './Timeline.astro';
import VerdictPanel from './VerdictPanel.astro';
import { parseBundle, SCENARIO_ORDER, type Bundle } from '../lib/bundle';

/**
 * Bundle strings are capped and redacted (never arbitrary user text), so a
 * literal `</script>` inside one is not expected -- but this is the only
 * place a bundle's own text lands inside an inline `<script>` tag, so the
 * closing sequence is escaped defensively rather than trusted.
 */
function bundleJson(bundle: Bundle): string {
  return JSON.stringify(bundle).replace(/</g, '\\u003c');
}

// Real bundles win once `record_site_scenarios.py` + `build_replays.py` have
// run; until then (and in this repo today) `../data/scenarios/*.json` is
// empty and the committed fixture stands in, exactly like Hero.astro's
// fallback. Both globs are eager: bundles are small, committed JSON and the
// page is fully static -- there is no benefit to a lazy import here.
const scenarioModules = import.meta.glob('../data/scenarios/*.json', { eager: true }) as Record<
  string,
  { default: unknown }
>;
const fixtureModules = import.meta.glob('../data/fixtures/*.json', { eager: true }) as Record<
  string,
  { default: unknown }
>;
const sourceModules = Object.keys(scenarioModules).length > 0 ? scenarioModules : fixtureModules;

function nameFromPath(modulePath: string): string {
  return modulePath.split('/').pop()?.replace(/\.json$/, '') ?? modulePath;
}

const byName = new Map<string, Bundle>();
for (const [modulePath, mod] of Object.entries(sourceModules)) {
  const bundle = parseBundle(mod.default);
  byName.set(nameFromPath(modulePath), bundle);
}

// Tab order is `SCENARIO_ORDER` (mirrors `replay_schema.SCENARIO_ORDER`),
// filtered down to whichever bundles are actually present -- the same
// filter `build_replays.py` applies against the committed ledgers.
const bundles: Bundle[] = SCENARIO_ORDER.filter((name) => byName.has(name)).map(
  (name) => byName.get(name) as Bundle,
);
const activeBundle = bundles[0];
---

{
  activeBundle && (
    <section class="replay" id="replay" aria-labelledby="replay-heading" data-replay>
      <div class="container">
        <h2 id="replay-heading">Replay a session</h2>
        <p class="replay-intro">
          Real recorded runs, one hook event at a time: what agent-verdict recorded, what it asked, and what it
          decided.
        </p>

        <ScenarioTabs bundles={bundles} activeName={activeBundle.name} />

        {bundles.map((bundle, i) => (
          <section
            class="scenario-panel"
            id={`panel-${bundle.name}`}
            role="tabpanel"
            aria-labelledby={`tab-${bundle.name}`}
            data-scenario={bundle.name}
            hidden={i !== 0}
          >
            <p class="scenario-summary">{bundle.summary}</p>
            <script type="application/json" data-bundle set:html={bundleJson(bundle)} />

            {/* One controls bar per scenario section: each section is a
               self-contained ReplayPlayer root (DOM contract), and only the
               active section's controls are ever visible at once. */}
            <div class="controls" role="group" aria-label="Playback controls">
              <button type="button" data-play>
                Play
              </button>
              <button type="button" data-pause>
                Pause
              </button>
              <button type="button" data-step>
                Step
              </button>
              <button type="button" data-restart>
                Restart
              </button>
            </div>

            <div class="replay-grid">
              <Timeline bundle={bundle} />
              <VerdictPanel bundle={bundle} />
            </div>
          </section>
        ))}
      </div>
    </section>
  )
}

<script>
  import { ReplayPlayer, initScenarioTabs } from '../islands/replay-player';
  import { parseBundle, type Bundle } from '../lib/bundle';

  const replayRoot = document.querySelector<HTMLElement>('[data-replay]');
  if (replayRoot) {
    const tablist = replayRoot.querySelector<HTMLElement>('[data-tabs]');
    const sections = new Map<string, HTMLElement>();
    replayRoot.querySelectorAll<HTMLElement>('[data-scenario]').forEach((section) => {
      const name = section.dataset.scenario;
      if (name) sections.set(name, section);
    });

    // Each scenario section carries its own bundle JSON (see the
    // `<script type="application/json" data-bundle>` sibling markup below)
    // rather than re-fetching it: `build_replays.py`/the fixture already
    // put it on the page for `parseBundle`'s SSR-time use.
    const bundles = new Map<string, Bundle>();
    sections.forEach((section, name) => {
      const dataEl = section.querySelector<HTMLScriptElement>('script[data-bundle]');
      if (!dataEl?.textContent) return;
      try {
        bundles.set(name, parseBundle(JSON.parse(dataEl.textContent)));
      } catch {
        // Malformed bundle JSON: skip it; that scenario simply won't play.
      }
    });

    let player: ReplayPlayer | null = null;

    function mount(name: string): void {
      const section = sections.get(name);
      const bundle = bundles.get(name);
      if (!section || !bundle) return;
      player?.pause();
      player = new ReplayPlayer(section, bundle);
    }

    sections.forEach((section, name) => {
      if (!section.hidden) mount(name);
    });

    if (tablist) {
      initScenarioTabs(tablist, (name) => {
        sections.forEach((section, sectionName) => {
          section.hidden = sectionName !== name;
        });
        mount(name);
      });
    }
  }
</script>

<style>
  .replay {
    padding-block: var(--space-8);
    border-top: 1px solid #1d2127;
  }

  .replay h2 {
    font-size: clamp(1.6rem, 1rem + 2vw, 2.2rem);
  }

  .replay-intro {
    margin-top: var(--space-3);
    max-width: 60ch;
    color: var(--muted);
  }

  .controls {
    margin-top: var(--space-6);
    display: flex;
    gap: var(--space-3);
  }

  .controls button {
    background: #12151a;
    border: 1px solid #1d2127;
    color: var(--text);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-4);
    font-size: 0.85rem;
    cursor: pointer;
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .controls button:hover {
    opacity: 0.85;
  }

  .controls button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .scenario-panel {
    margin-top: var(--space-6);
  }

  .scenario-summary {
    color: var(--muted);
    max-width: 70ch;
    margin-bottom: var(--space-5);
  }

  .replay-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  @media (max-width: 900px) {
    .replay-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
