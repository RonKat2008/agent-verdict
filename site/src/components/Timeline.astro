---
import type { Bundle, BundleEvent } from '../lib/bundle';
import { decisionLabel, formatDecision, verdictIndexForEvent } from '../islands/replay-player';

export interface Props {
  bundle: Bundle;
}

const { bundle } = Astro.props;
const { effectiveAction } = formatDecision(bundle);
const actionLabel = decisionLabel(bundle);

/**
 * The command column's content for the housekeeping rows that carry no
 * `command` of their own: a `verdict` event names the question it answered
 * and that answer (same positional mapping `ReplayPlayer.step()` uses, so
 * the no-JS row already reads correctly); an `action` event repeats the
 * verdict panel's decision label; a `stop` event is labeled plainly, since
 * the final message itself is shown elsewhere (the hero terminal), not
 * duplicated here.
 */
type CommandContent =
  | { kind: 'plain'; text: string }
  | { kind: 'verdict'; key: string; value: string }
  | { kind: 'decision' }
  | { kind: 'stop' };

function commandContent(event: BundleEvent, index: number): CommandContent {
  if (event.kind === 'verdict') {
    const question = bundle.questions[verdictIndexForEvent(bundle, index)];
    if (question) {
      return { kind: 'verdict', key: question.key, value: (question.answer ?? 0).toFixed(2) };
    }
    return { kind: 'plain', text: '' };
  }
  if (event.kind === 'action') return { kind: 'decision' };
  if (event.kind === 'stop') return { kind: 'stop' };
  return { kind: 'plain', text: event.command };
}

/**
 * `+1.2s`: the event's `t_ms` offset from session start, one decimal place.
 * `t_ms` is always >= 0 (it is an offset), so no sign handling is needed
 * beyond the literal `+`.
 */
function formatOffset(tMs: number): string {
  return `+${(tMs / 1000).toFixed(1)}s`;
}

/**
 * Status/exit code color: an error status (or a nonzero exit code) reads in
 * the block color, `ok` in the pass color, and an event with no status
 * (prompt/stop/verdict/action -- housekeeping rows, not tool results) in
 * the muted color.
 */
function statusClass(event: BundleEvent): string {
  if (event.status === 'error') return 'status-error';
  if (event.status === 'ok') return 'status-ok';
  return 'status-muted';
}

function statusText(event: BundleEvent): string {
  if (event.status === null && event.exit_code === null) return '';
  const parts: string[] = [];
  if (event.status) parts.push(event.status);
  if (event.exit_code !== null) parts.push(`exit ${event.exit_code}`);
  return parts.join(' ');
}
---

<div class="timeline" data-timeline>
  {
    bundle.events.map((event, index) => {
      const content = commandContent(event, index);
      return (
        <div class="row revealed" data-seq={event.seq}>
          <span class="cell seq mono">{event.seq}</span>
          <span class="cell t mono">{formatOffset(event.t_ms)}</span>
          <span class={`cell kind-badge kind-${event.kind}`}>{event.kind}</span>
          <span class="cell tool mono">{event.tool ?? '—'}</span>
          <span class="cell command mono">
            {content.kind === 'plain' && content.text}
            {content.kind === 'verdict' && (
              <span class="ev-verdict">
                <span class="ev-key">{content.key}</span> <span class="ev-value">{content.value}</span>
              </span>
            )}
            {content.kind === 'decision' && <span class={`ev-decision ${effectiveAction}`}>{actionLabel}</span>}
            {content.kind === 'stop' && <span class="ev-stop">final message</span>}
          </span>
          <span class={`cell status mono ${statusClass(event)}`}>{statusText(event)}</span>
        </div>
      );
    })
  }
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .row {
    display: grid;
    grid-template-columns: 2.5ch 4.5ch auto 6ch 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: #101317;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 260ms var(--ease-out, ease), transform 260ms var(--ease-out, ease);
  }

  .row.revealed {
    opacity: 1;
    transform: none;
  }

  .cell {
    font-size: 0.82rem;
  }

  .seq,
  .t {
    color: var(--muted);
  }

  .command {
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ev-key {
    color: var(--muted);
  }

  .ev-value {
    color: var(--text);
  }

  .ev-stop {
    color: var(--muted);
  }

  .ev-decision {
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 500;
  }

  .ev-decision.pass {
    color: var(--pass);
  }

  .ev-decision.flag {
    color: var(--flag);
  }

  .ev-decision.block {
    color: var(--block);
  }

  .ev-decision.gate_unavailable {
    color: var(--muted);
  }

  .kind-badge {
    justify-self: start;
    padding: 2px var(--space-2);
    border-radius: 999px;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid #1d2127;
    white-space: nowrap;
  }

  .kind-post_fail {
    color: var(--block);
    border-color: var(--block);
  }

  .kind-verdict {
    color: var(--accent);
    border-color: var(--accent);
  }

  .kind-action {
    color: var(--flag);
    border-color: var(--flag);
  }

  .status {
    justify-self: end;
    white-space: nowrap;
  }

  .status-ok {
    color: var(--pass);
  }

  .status-error {
    color: var(--block);
  }

  .status-muted {
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: 2ch 4ch auto 1fr;
      grid-template-areas: 'seq t kind status' 'command command command command';
    }

    .tool {
      display: none;
    }

    .command {
      grid-column: 1 / -1;
      white-space: normal;
    }
  }
</style>
