---
const REPO_URL = 'https://github.com/RonKat2008/agent-verdict';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label="Footer">
      <a href={REPO_URL}>Repository</a>
      <a href={`${REPO_URL}/blob/main/docs/PRIVACY.md`}>PRIVACY</a>
      <a href={`${REPO_URL}/blob/main/docs/CONSENT.md`}>CONSENT</a>
    </nav>
    <p class="footer-note mono">Numbers come from commands in the repo.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid #1d2127;
    padding-block: var(--space-6);
    margin-top: var(--space-8);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer-links {
    display: flex;
    gap: var(--space-5);
  }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--accent);
  }

  .footer-note {
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
